# Copy to users_database.yml (gitignored) and replace the password hash.
# Generate the hash with:
#   docker run --rm authelia/authelia:4.39.24 \
#     authelia crypto hash generate argon2 --password 'demo-pass' --no-confirm
# and paste everything after "Digest: " below.
users:
  demo:
    displayname: "Demo User"
    password: "CHANGE_ME_ARGON2ID_HASH"
    email: "demo@example.com"
