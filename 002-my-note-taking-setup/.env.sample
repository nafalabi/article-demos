# Copy to .env and fill it in. Never commit .env.
#
# HOST_IP: LAN IPv4 address of the machine running this stack. Every hostname
# and the certificate are built from it.
HOST_IP=
TZ=Asia/Jakarta

# WebDAV credentials, used by phone/desktop Obsidian. Must not be empty.
WEBDAV_USER=ignis
WEBDAV_PASS=CHANGE_ME_WEBDAV_PASSWORD

# Git host for vault version control. Leaving the CHANGE_ME placeholder is
# allowed: the git UI still runs locally, but pushes fail until it is set.
GIT_REMOTE_BASE_URL=CHANGE_ME_GIT_BASE_URL
GIT_USER=CHANGE_ME_GIT_USER
GIT_TOKEN=CHANGE_ME_GIT_TOKEN

# MCP server for external agents. MCP_AUTH_TOKEN is required; generate it with
#   openssl rand -hex 32
# MCP_GIT_TOKEN is used only by MCP, so agent push access can be revoked
# without breaking lazygit.
MCP_AUTH_TOKEN=CHANGE_ME_MCP_AUTH_TOKEN
MCP_GIT_TOKEN=CHANGE_ME_MCP_GIT_TOKEN
MCP_GIT_AUTHOR_NAME=hermes
MCP_GIT_AUTHOR_EMAIL=hermes@homelab.local
