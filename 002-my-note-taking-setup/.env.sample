# Copy to .env and fill it in. Never commit .env.
#
# HOST_IP: LAN IPv4 address of the machine running this stack. Every hostname
# and the certificate are built from it.
HOST_IP=
TZ=Asia/Jakarta

# 64+ character random strings, one per purpose:
#   openssl rand -hex 32
AUTHELIA_SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARS
AUTHELIA_STORAGE_ENCRYPTION_KEY=CHANGE_ME_64_RANDOM_CHARS

# Login for the demo user. The password lives in plaintext because the
# automated verification logs in through the Authelia API; the argon2id hash
# derived from it lives in config/authelia/users_database.yml. The username is
# not a secret and is fixed as "demo" to match users_database.yml.sample.
AUTHELIA_DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# WebDAV credentials, used by phone/desktop Obsidian. Must not be empty.
WEBDAV_USER=ignis
WEBDAV_PASS=CHANGE_ME_WEBDAV_PASSWORD

# Git host for vault version control. Leaving the CHANGE_ME placeholder is
# allowed: the git UI still runs locally, but pushes fail until it is set.
GIT_REMOTE_BASE_URL=CHANGE_ME_GIT_BASE_URL
GIT_USER=CHANGE_ME_GIT_USER
GIT_TOKEN=CHANGE_ME_GIT_TOKEN
